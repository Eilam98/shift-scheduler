generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the running app
  directUrl = env("DIRECT_URL") // direct connection, used by `prisma migrate`
}

enum ShiftLabel {
  MORNING
  EVENING
}

enum ScheduleStatus {
  DRAFT
  POSTED
}

enum PayType {
  FIXED // hourly rate, clocks in at the time clock station
  TIPS // paid from the shift's tip pool, with an optional guaranteed minimum
}

enum Language {
  HE
  EN
}

enum NotificationType {
  SCHEDULE_POSTED // a week you're scheduled in was posted
  SHIFT_ADDED // you were put on a slot of a posted week
  SHIFT_REMOVED // you were taken off a slot of a posted week
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  pinHash                String? // time clock station PIN, hashed like passwords
  language               Language? // null = restaurant default
  isActive               Boolean   @default(true) // deactivate instead of delete, so history stays
  isRestaurantManager    Boolean   @default(false)
  requiresPasswordChange Boolean   @default(true)
  createdAt              DateTime  @default(now())

  memberships        DepartmentMembership[]
  managedDepartments DepartmentManager[]
  slots              ShiftSlot[]
  availability       Availability[]
  notifications      Notification[]
}

model Department {
  id   String @id @default(cuid())
  name String @unique // "Waiters", "Hostesses", "Bar", "Shift Managers"

  members         DepartmentMembership[]
  manager         DepartmentManager?
  payRates        DepartmentPayRate[]
  slots           ShiftSlot[]
  departmentWeeks DepartmentSchedule[]
  notifications   Notification[]
}

// Who WORKS in a department (can be put on its slots).
model DepartmentMembership {
  id           String @id @default(cuid())
  userId       String
  departmentId String
  hourlyBonus  Int    @default(0) // agorot/hour, always added on top of the department rate

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
}

// Who MANAGES a department — independent of working in it. A department has
// at most one manager (departmentId is unique); a user can manage several.
// The restaurant manager is never listed here: they manage every department.
model DepartmentManager {
  id           String @id @default(cuid())
  userId       String
  departmentId String @unique

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
}

// Pay rate history: the row with the latest effectiveFrom <= a date applies to
// that date, so changing a rate never rewrites past months. Money in agorot.
model DepartmentPayRate {
  id                String   @id @default(cuid())
  departmentId      String
  effectiveFrom     DateTime // UTC midnight of the first day the rate applies
  payType           PayType
  hourlyRate        Int? // FIXED: agorot/hour (null = not set yet)
  minimumHourlyRate Int? // TIPS: guaranteed minimum agorot/hour (null = none)

  department Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, effectiveFrom])
}

// Restaurant-wide settings — always exactly one row (id 1).
model RestaurantSettings {
  id                       Int      @id @default(1)
  availabilityDeadlineDay  Int      @default(3) // 0=Sun … 6=Sat, in the week BEFORE the schedule week
  availabilityDeadlineTime String   @default("23:59") // "HH:mm" in timeZone
  defaultLanguage          Language @default(HE)
  timeZone                 String   @default("Asia/Jerusalem")
}

// Restaurant-wide default start/end time per shift label, overridable per shift
model ShiftTemplate {
  id               String     @id @default(cuid())
  label            ShiftLabel @unique
  defaultStartTime String // "08:00"
  defaultEndTime   String // "16:00"
}

// One container per week
model Schedule {
  id            String   @id @default(cuid())
  weekStartDate DateTime @unique

  shifts              Shift[]
  departmentSchedules DepartmentSchedule[]
  notifications       Notification[]
}

// Per-department posting status for a given week
model DepartmentSchedule {
  id           String         @id @default(cuid())
  scheduleId   String
  departmentId String
  status       ScheduleStatus @default(DRAFT)
  postedAt     DateTime?

  schedule   Schedule   @relation(fields: [scheduleId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([scheduleId, departmentId])
}

// One shift = one date + label, shared across all departments
model Shift {
  id         String     @id @default(cuid())
  scheduleId String
  date       DateTime
  label      ShiftLabel
  startTime  String
  endTime    String

  schedule      Schedule       @relation(fields: [scheduleId], references: [id])
  slots         ShiftSlot[]
  notifications Notification[]

  @@unique([scheduleId, date, label])
}

// One literal slot: empty (userId null) or filled by a worker.
// Managers add/remove these rows manually — no stored default count.
model ShiftSlot {
  id           String  @id @default(cuid())
  shiftId      String
  departmentId String
  userId       String?

  shift      Shift      @relation(fields: [shiftId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
}

// Per-shift-label availability, submitted before Shift rows exist for that week
model Availability {
  id        String     @id @default(cuid())
  userId    String
  date      DateTime
  label     ShiftLabel
  available Boolean    @default(true)
  note      String?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date, label])
}

// In-app notification. Stores WHAT happened, not text — the client builds the
// sentence in the reader's language. Web Push (step 9) will reuse these rows.
model Notification {
  id           String           @id @default(cuid())
  userId       String // recipient
  type         NotificationType
  departmentId String
  scheduleId   String // the week
  shiftId      String? // SHIFT_ADDED / SHIFT_REMOVED
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  schedule   Schedule   @relation(fields: [scheduleId], references: [id])
  shift      Shift?     @relation(fields: [shiftId], references: [id])

  @@index([userId, createdAt])
}
