# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# From your Neon project dashboard → Connect. Use the POOLED string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Same string with "-pooler" removed from the host — Prisma uses this for migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Any long random string — used to sign JWTs
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Used only by `npx prisma db seed` to create the first restaurant manager.
# The password is temporary — you're forced to change it on first login.
# Must be 8+ characters with at least one letter and one number.
SEED_MANAGER_NAME="Your Name"
SEED_MANAGER_EMAIL="you@example.com"
SEED_MANAGER_PASSWORD=""

# Key for hashing time clock PINs (HMAC) so they can be looked up and kept unique.
# Any long random string. Changing it invalidates every PIN (regenerate them).
PIN_SECRET="replace-with-another-long-random-string"

# Web Push (phone notifications). Generate once: npx web-push generate-vapid-keys
# Keep them stable — new keys mean every phone must turn notifications on again.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push services: a mailto: address or the app's https URL.
VAPID_SUBJECT="mailto:admin@example.com"
