{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "prod-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.chdir('server');process.env.PORT='4100';require(require('path').resolve('dist/index.js'))"
      ],
      "port": 4100
    }
  ]
}
